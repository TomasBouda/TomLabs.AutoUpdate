<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Authors>Tomas Bouda</Authors>
    <Company>TomLabs</Company>
    <VersionPrefix>0.3.1</VersionPrefix>
    <RepositoryUrl>https://github.com/TomasBouda/TomLabs.AutoUpdate</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/TomasBouda/TomLabs.AutoUpdate</PackageProjectUrl>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Apps publish the library as a project reference; keep their output to the exe alone. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>
</Project>
